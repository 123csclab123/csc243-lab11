class ScubaTank:
    def __init__(self,label,bar):
        self.label=label
        self.__bar=bar
    def get_bar(self):
            return self.__bar
    def set_bar(self,bar):
            if 0 <=bar <=300:
                self.__bar=bar
            else: 
                print("invalid pressure")
    def fill(self,amount):
            if amount > 0:
                self.__bar += amount
            else:
                  print ("invalid  amount")
    def release (self,amount):
             if amount <= 0:
                 print ('invalid amount')
             elif amount  > self.__bar  :
                   print ('not enough air')
             else:
                  self.__bar -=amount
    def __str__(self):
            return "tank" + self.label + ": "+ str(self.__bar)+ " bar"
def transfer_air ( source , target , amount ) :
    if source.get_bar() >= amount:
        source.release(amount)
        target.fill(amount)
    else:
        source.release(amount)
